{
  "name": "tyf-web",
  "version": "1.0.0",
  "private": true,
  "description": "Try your Fit — marketing site, waitlist + pilot API, and admin console.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:destroy": "docker compose down --volumes",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U tyf -d tyf",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-db.js",
    "db:seed": "node scripts/seed-db.js",
    "export": "node scripts/export-csv.js",
    "token": "node scripts/make-token.js"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "express": "^5.1.0",
    "pg": "^8.22.0"
  }
}
