# ─────────────────────────────────────────────────────────────────────────
# Try your Fit — configuration
# Copy to `.env` and adjust. Everything here has a working default except
# ADMIN_TOKEN, which you must set before going anywhere near production.
# ─────────────────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# ── server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Behind nginx / a platform load balancer, set to the number of proxies
# in front of this process (usually 1) so rate limiting sees real client IPs.
TRUST_PROXY=loopback

# ── database ─────────────────────────────────────────────────────────────
# Relative paths resolve from the project root.
DATABASE_PATH=data/tyf.db

# ── admin console (/admin) ───────────────────────────────────────────────
# Generate one with: npm run token
# Leave unset in development and the server prints a temporary token at boot.
ADMIN_TOKEN=
ADMIN_SESSION_HOURS=12

# Salt used to hash client IPs before storage. Defaults to a value derived
# from ADMIN_TOKEN; set it explicitly if you ever rotate the token and want
# existing hashes to stay comparable.
IP_SALT=

# ── security ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API cross-origin.
# Empty means same-origin only, which is what the site itself needs.
ALLOWED_ORIGINS=
ENABLE_CSP=true

# ── rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_READ_MAX=240
RATE_LIMIT_WRITE_MAX=8
RATE_LIMIT_LOGIN_MAX=10

# ── product ──────────────────────────────────────────────────────────────
# Display-only offset for the public waitlist counter. Keep at 0 to show the
# true number of signups.
STATS_BASELINE=0
CONTACT_EMAIL=hello@triyetech.com

# debug | info | warn | error | silent
LOG_LEVEL=debug
