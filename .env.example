# ─────────────────────────────────────────────────────────────────────────
# Try your Fit — configuration
# Copy to `.env` and adjust. Everything here has a working default except
# ADMIN_TOKEN, which you must set before going anywhere near production.
# ─────────────────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# ── server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Behind nginx / a platform load balancer, set to the number of proxies
# in front of this process (usually 1) so rate limiting sees real client IPs.
TRUST_PROXY=loopback

# ── database ─────────────────────────────────────────────────────────────
# LOCAL: the Postgres in docker-compose.yml. Nothing to sign up for:
#
#   npm run db:up && npm run db:migrate
#
# Host port 5433, not 5432 — a machine-wide Postgres install usually owns
# 5432 already. Change POSTGRES_PORT below if 5433 is taken too.
DATABASE_URL=postgresql://tyf:tyf@localhost:5433/tyf
# POSTGRES_PORT=5433
#
# PRODUCTION: Supabase dashboard -> Project Settings -> Database.
# Use the *Transaction pooler* string (port 6543), NOT the direct one (5432).
# Serverless instances open and drop connections constantly; the direct port
# runs out of them within minutes of real traffic.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Connections held per instance. 1 on serverless (each instance keeps its own),
# ~10 for a single long-running server. Left unset it picks the right default.
# DATABASE_POOL_MAX=

# TLS. Unset is right almost always: off for localhost, on for everything else.
# Only set it by hand for a remote database that genuinely has no TLS.
# DATABASE_SSL=

# ── admin console (/admin) ───────────────────────────────────────────────
# Generate one with: npm run token
# Leave unset in development and the server prints a temporary token at boot.
ADMIN_TOKEN=
ADMIN_SESSION_HOURS=12

# Salt used to hash client IPs before storage. Defaults to a value derived
# from ADMIN_TOKEN; set it explicitly if you ever rotate the token and want
# existing hashes to stay comparable.
IP_SALT=

# ── security ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API cross-origin.
# Empty means same-origin only, which is what the site itself needs.
ALLOWED_ORIGINS=
ENABLE_CSP=true

# ── rate limiting ────────────────────────────────────────────────────────
# Upstash Redis, so the limits are shared across serverless instances.
# `vercel integration add upstash` sets these for you on Vercel.
# Leave them empty locally: the limiter falls back to in-process counters,
# which are correct on a single server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_READ_MAX=240
RATE_LIMIT_WRITE_MAX=8
RATE_LIMIT_LOGIN_MAX=10

# ── product ──────────────────────────────────────────────────────────────
# Display-only offset for the public waitlist counter. Keep at 0 to show the
# true number of signups.
STATS_BASELINE=0
CONTACT_EMAIL=hello@triyetech.com

# debug | info | warn | error | silent
LOG_LEVEL=debug
