# Normalise line endings: LF in the repository, native in the working copy.
# Without this, checking out on Windows and Linux produces diffs that are
# nothing but invisible carriage returns.
* text=auto eol=lf

# Windows-only helpers keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.woff  binary
*.woff2 binary
*.db   binary

# Keep generated noise out of diffs and language stats
package-lock.json      -diff linguist-generated
archive/*              linguist-vendored
